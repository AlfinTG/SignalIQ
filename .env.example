# Copy to .env in the repository root. Never commit real keys.

# Optional. Enables live Gemini analysis via the backend.
GEMINI_API_KEY=
# Optional. Default is gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Optional. Enables Adaption Adaptive Data (estimate + explicit run).
ADAPTION_API_KEY=

# development | production
APP_ENV=development

# Required for authenticated private workspaces. VITE_ values are public
# Supabase browser configuration, never service/database credentials.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Comma-separated origins for cross-origin browser access. Keep empty when the
# frontend is served by FastAPI on the same origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Server-only PostgreSQL connection string; never prefix this with VITE_.
DATABASE_URL=postgresql://signal_iq_app:replace_me@db.your-project.supabase.co:5432/postgres?sslmode=require

# Maximum records accepted by POST /api/analyze (default 80).
MAX_ANALYSIS_ROWS=80

# Host-provided port in production. Local default is 8000.
PORT=8000
